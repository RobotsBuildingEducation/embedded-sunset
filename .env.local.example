# Local development enables the Patreon preview by default. Set this to false
# only when you deliberately need to inspect the legacy local paywall.
VITE_PATREON_AUTH_ENABLED=true
# This is public checkout configuration, never an OAuth secret.
VITE_PATREON_CHECKOUT_URL=https://subscribe.piyali.app/

# Optional registered Firebase App Check token for local AI features.
# Keep the actual token in the ignored .env.local file, never in source control.
# Firebase console > App Check > test-data web app > Manage debug tokens.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
